#
# .editorconfig
#
# https://editorconfig.org/
#

root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.{c,h}]
inden_type = tab
indent_size = 4
trim_trailing_whitespace = true

[Makefile,Makefile.in,*.mk]
indent_style = tab
indent_size = 8
trim_trailing_whitespace = true

[*.sh]
inden_type = tab
indent_size = 4
trim_trailing_whitespace = true

[*.md]
inden_type = space
indent_size = 2
trim_trailing_whitespace = false

#
#
#
