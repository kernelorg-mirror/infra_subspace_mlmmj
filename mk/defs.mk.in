RANLIB=	@RANLIB@
AR=	@AR@
CC=	@CC@
@if asan
CFLAGS+=	@ASAN_CFLAGS@
LDFLAGS+=	@ASAN_LDFLAGS@
@endif
@if ubsan
CFLAGS+=	@UBSAN_CFLAGS@
LDFLAGS+=	@UBSAN_LDFLAGS@
@endif
@if coverage
CFLAGS+=	@COVERAGE_CFLAGS@
LDFLAGS+=	@COVERAGE_LDFLAGS@
@endif
PREFIX=		@prefix@
top_srcdir=	@abs_top_srcdir@
top_builddir=	@abs_top_builddir@
sbindir=	$(PREFIX)/sbin
bindir=		$(PREFIX)/bin
mandir=		@mandir@
datadir=	@datadir@
textlibdir=	@textlibdir@
MK=	$(top_srcdir)/mk

all:

clean:

install:

check:
