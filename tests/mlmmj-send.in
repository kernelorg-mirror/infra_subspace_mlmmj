#!@ATFSH@

. $(atf_get_srcdir)/test_env.sh

tests_init \
	basics \
	resend_keeps_subfile_on_failure \
	resend_removes_subfile_on_success \
	resend_fd_no_unlink

basics_body()
{

	mlmmjsend=$(command -v mlmmj-send)
	helptxt="Usage: $mlmmjsend [-L /path/to/list -m /path/to/mail | -l listctrl]
       [-a] [-D] [-F sender@example.org] [-h] [-o address@example.org]
       [-r 127.0.0.1] [-R reply@example.org] [-s /path/to/subscribers]
       [-T recipient@example.org] [-V]
 -a: Don't archive the mail
 -D: Don't delete the mail after it's sent
 -F: What to use as MAIL FROM:
 -h: This help
 -l: List control variable:
    '1' means 'send a single mail'
    '2' means 'mail to moderators'
    '3' means 'resend failed list mail'
    '4' means 'send to file with recipients'
    '5' means 'bounceprobe'
    '6' means 'single listmail to single recipient'
    '7' means 'digest'
 -L: Full path to list directory
 -m: Full path to mail file
 -o: Address to omit from distribution (normal mail only)
 -r: Relayhost IP address (defaults to 127.0.0.1)
 -R: What to use as Reply-To: header
 -s: Subscribers file name
 -T: What to use as RCPT TO:
 -V: Print version
"
	init_ml ml

	atf_check -s exit:1 -e "inline:mlmmj-send: You have to specify -m and -L or -l\n$mlmmjsend -h for help\n" $mlmmjsend
	atf_check -s exit:0 -o "match:mlmmj-send version " $mlmmjsend -V
	atf_check -s exit:0 -o "inline:$helptxt" $mlmmjsend -h
	atf_check -s exit:1 -e "inline:mlmmj-send: -l only accept the following arguments: 1, 2, 3, 4, 5, 6 or 7\n" $mlmmjsend -l 8
	atf_check -s exit:1 -e "inline:mlmmj-send: -l only accept the following arguments: 1, 2, 3, 4, 5, 6 or 7\n" $mlmmjsend -l 0
}

# Regression: mlmmj-send -l 3 used to delete the subscribers file even
# when sending failed, losing the queued addresses permanently.
resend_keeps_subfile_on_failure_body()
{
	mlmmjsend=$(command -v mlmmj-send)
	init_ml ml
	echo "ml@test" > ml/control/listaddress
	# Use a port where nothing is listening so connect fails
	echo "25679" > ml/control/smtpport
	echo "heloname" > ml/control/smtphelo
	cat > mailfile <<EOF
From: sender@test
To: ml@test
Subject: test

body
.
EOF
	cat > subsfile <<EOF
recip1@test
recip2@test
EOF
	# Send will fail because nothing listens on port 25679.
	$mlmmjsend -L ml -l 3 -m mailfile -s subsfile
	# The subscribers file must still exist
	atf_check -s exit:0 test -f subsfile
}

resend_removes_subfile_on_success_body()
{
	mlmmjsend=$(command -v mlmmj-send)
	atf_check $top_builddir/tests/fakesmtpd
	trap kill_fakesmtp EXIT TERM
	init_ml ml
	echo "ml@test" > ml/control/listaddress
	echo "25678" > ml/control/smtpport
	echo "heloname" > ml/control/smtphelo
	cat > mailfile <<EOF
From: sender@test
To: ml@test
Subject: test

body
.
EOF
	cat > subsfile <<EOF
recip@test
EOF
	atf_check -s exit:0 $mlmmjsend -L ml -l 3 -m mailfile -s subsfile
	# On success the subscribers file must be removed
	atf_check -s exit:1 test -f subsfile
}

# Regression: when -s is a numeric fd (inherited file descriptor), the
# old code did unlink("5") which would delete an unrelated file literally
# named "5" in the cwd. The fix skips unlink when subfilename is numeric.
resend_fd_no_unlink_body()
{
	mlmmjsend=$(command -v mlmmj-send)
	atf_check $top_builddir/tests/fakesmtpd
	trap kill_fakesmtp EXIT TERM
	init_ml ml
	echo "ml@test" > ml/control/listaddress
	echo "25678" > ml/control/smtpport
	echo "heloname" > ml/control/smtphelo
	cat > mailfile <<EOF
From: sender@test
To: ml@test
Subject: test

body
.
EOF
	cat > subsfile <<EOF
recip@test
EOF
	# Create a file named "9" that must not be deleted
	echo "unrelated data" > 9
	atf_check -s exit:0 test -f 9
	# Open subsfile on fd 9, then pass "9" as the -s argument.
	# Run mlmmj-send directly (not via atf_check) to preserve fd 9.
	exec 9<subsfile
	$mlmmjsend -L ml -l 3 -m mailfile -s 9
	exec 9<&-
	# The file literally named "9" must still exist
	atf_check -s exit:0 test -f 9
}
