#!@ATFSH@

. $(atf_get_srcdir)/test_env.sh

tests_init \
	usage \
	basic_0 \
	basic_1 \
	basic_2 \
	basic_3 \
	basic_4 \
	basic_5 \
	addr_in_to_cc \
	owner_recipextra \
	cleanup_queue_on_owner_write_failure

mlmmjprocess=$(command -v mlmmj-process)
usage_body()
{
	output="Usage: $mlmmjprocess -L /path/to/list
       -m /path/to/mail [-h] [-P] [-V]
 -h: This help
 -L: Full path to list directory
 -m: Full path to mail file
 -P: Don't execute mlmmj-send
 -V: Print version
"
	atf_check -o inline:"$output" $mlmmjprocess -h
}

basic_0_body()
{
	output="mlmmj-process: You have to specify -L and -m
$mlmmjprocess -h for help
"
	atf_check -s exit:1 -e inline:"$output" $mlmmjprocess
}

basic_1_body()
{
	output="mlmmj-process: You have to specify -L and -m
$mlmmjprocess -h for help
"
	atf_check -s exit:1 -e inline:"$output" $mlmmjprocess -L plop
}

basic_2_body()
{
	atf_check -s exit:1 -e inline:"mlmmj-process: Cannot open(plop): No such file or directory\n" $mlmmjprocess -L plop -m meh
}

basic_3_body()
{
	mkdir plop
	atf_check -s exit:1 -e inline:"mlmmj-process: Cannot open(plop/control): No such file or directory\n" $mlmmjprocess -L plop -m meh
}

basic_4_body()
{
	mkdir -p plop/control
	echo "test@test" > plop/control/listaddress
	atf_check -s exit:1 $mlmmjprocess -L plop -m meh
}

basic_5_body()
{
	mkdir -p plop/control
	mkdir -p plop/queue
	echo "test@test" > plop/control/listaddress
	atf_check -s exit:1 $mlmmjprocess -L plop -m meh
}

addr_in_to_cc_body()
{
	init_ml list
cat > mailfile <<EOF
Return-Path: sender@yeah
From: sender@yeah
Bcc: list@test
EOF
	echo "list@test" > list/control/listaddress
# ensure we don't try to really send email to a real mailserver
	echo 1 > list/control/smtpport
	rmdir list/text
	ln -s ${top_srcdir}/listtexts/en list/text
	atf_check -s exit:0 $mlmmjprocess -L list -m mailfile
	rm list/queue/*.reciptto
	rm list/queue/*.mailfrom
	rmdir list/queue/discarded
	atf_check -o match:".*The message from <sender@yeah> with subject \"\" was unable to be delivered.*" cat list/queue/*
}

# Regression: the openat() for the "owner" control file used to be
# outside the "owner" conditional, meaning it was called for all
# recipextra values (wasting an fd). After the fix it's inside the
# conditional. Verify the owner path still works: mlmmj-process with
# EXTENSION=owner must read the owner file and deliver to its address.
owner_recipextra_body()
{
	init_ml list
	rmdir list/text
	ln -s ${top_srcdir}/listtexts/en list/text
	echo "list@test" > list/control/listaddress
	start_fakesmtp list
	echo "heloname" > list/control/smtphelo
	echo "theowner@test" > list/control/owner
	cat > mailfile <<EOF
Return-Path: sender@test
From: sender@test
To: list+owner@test
Subject: please forward to owner

hello owner
EOF
	EXTENSION=owner atf_check -s exit:0 $mlmmjprocess -L list -m mailfile
	# fakesmtpd recorded the SMTP session; verify the owner got the mail
	atf_check -o match:"RCPT TO:<theowner@test>" cat mail-1.txt
}

cleanup_queue_on_owner_write_failure_body()
{
	# Test that queue file is cleaned up when the second do_all_the_voodoo_here
	# (in the owner-forwarding path) fails.
	#
	# We use ulimit -n to limit file descriptors. With a tight limit, the
	# first voodoo succeeds but the second fails on dup().
	init_ml list
	echo "list@test" > list/control/listaddress
	echo 1 > list/control/smtpport
	echo "theowner@test" > list/control/owner
	rmdir list/text
	ln -s ${top_srcdir}/listtexts/en list/text

	# Test with decreasing fd limits starting from 30
	# Create mailfile each iteration because successful runs delete it
	limit=30
	while [ $limit -ge 3 ]; do
		rm -f list/queue/[!d]* 2>/dev/null || true
		cat > mailfile <<EOF
Return-Path: sender@example.com
From: sender@example.com
To: list+owner@test
Subject: Test

Hello
EOF
		(exec 2>/dev/null; ulimit -n $limit; EXTENSION=owner $mlmmjprocess -L list -m mailfile -P)
		rc=$?
		qcount=$(find list/queue -maxdepth 1 -type f 2>/dev/null | wc -l)
		if [ "$rc" -ne 0 ] && [ "$qcount" -gt 0 ]; then
			# Found failure with leftover file - this is the bug
			ls -la list/queue/
			atf_fail "queue file left behind after failure (ulimit -n $limit)"
		fi
		limit=$((limit - 1))
	done
}
