%ifaction sub%Subject: Přihlášeno do $list$@$domain$: $subaddr$%endif%
%ifaction unsub%Subject: Odhlášeno z $list$@$domain$: $subaddr$%endif%

%text prologue%

%ifaction sub%
  %^%%wrap%Adresa <$subaddr$> byla přihlášena za člena
  %iftype normal% normal %endif%
  %iftype digest% digest %endif%
  %iftype nomail% no-mail %endif%
  verze konference, protože
  %ifreason request%
    byl přijat požadavek na přihlášení.
  %endif%
  %ifreason confirm%
    byl potvrzen požadavek na přihlášení.
  %endif%
  %ifreason admin%
    to tak učinil správce.
  %endif%
  %ifreason permit%
    to schválil moderátor.
  %endif%
%endif%

%ifaction unsub%
  %^%%wrap%Adresa <$subaddr$> byla odhlášena z konference
  %ifreason request%
    byl přijat požadavek na odhlášení.
  %endif%
  %ifreason confirm%
    byl potvrzen požadavek na odhlášení.
  %endif%
  %ifreason admin%
    to tak učinil správce.
  %endif%
  %ifreason bouncing%
    se nepodařilo ji odeslat ve stanovené lhůtě (bouncing).
  %endif%
%endif%

