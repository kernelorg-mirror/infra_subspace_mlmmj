%ifaction sub%Subject: Není možné přihlásit se do $list$@$domain$%endif%
%ifaction unsub%Subject: Není možné odhlásit se z $list$@$domain$%endif%
%ifaction release reject%Subject: Není možné moderovat $list$@$domain$%endif%
%ifaction permit obstruct%Subject: Není možné spravovat $list$@$domain$%endif%

%text prologue%

%ifaction sub%
  %^%%wrap%Není možné přihlásit se do konference,
  %ifreason disabled%
    protože
    %iftype normal% normal %endif%
    %iftype digest% digest %endif%
    %iftype nomail% no-mail %endif%
    verze zasílání je vypnutá.
  %endif%
  %ifreason closed%
    protože je zakázáno přihlašovat se zasláním zprávy.
  %endif%
  %ifreason subbed%
    protože už jste členem.
  %endif%
  %ifreason expired%
    protože uplynulo příliš mnoho času a nikdo neschválil žádost.
  %endif%
  %ifreason obstruct%
    protože Vaše žádost o přihlášení byla zamítnuta.
  %endif%
%endif%

%ifaction unsub%
  %^%%wrap%Není možné odhlásit se z konference,
  %ifreason unsubbed%
    protože nejste jejím členem.

    %^%%wrap%Pokud si myslíte, že členem jste, možná jste přihlášení s jinou
    emailovou adresou. Můžete ji zjistit z uvítacího emailu, který jste
    obdrželi po přihlášení do konference. Hledejte pole "Return-Path" v
    hlavičce uvítacího emailu.
  %endif%
%endif%

%ifaction release reject%
  %^%%wrap%
  %ifaction release%
    Nemůžete uvolnit zprávu do konference,
  %endif%
  %ifaction reject%
    Nemůžete zamítnout tuto zprávu,
  %endif%
  %ifreason notfound%
    protože nebyla nalezena. Možná už ji uvolnil nebo zamítnul jiný moderátor,
    nebo požadavek vypršel.
  %endif%
  %ifreason moderators%
    protože nejste moderátorem konference.
  %endif%
%endif%

%ifaction permit obstruct%
  %^%%wrap%
  %ifaction permit%
    Nemůžete schválit požadavek na přihlášení do konference,
  %endif%
  %ifaction obstruct%
    Nemůžete zamítnout požadavek na přihlášení do konference,
  %endif%
  %ifreason notfound%
    protože nebyl nalezen. Možná už jej schválil nebo zamítnul jiný správce,
    nebo vypršela lhůta pro schválení.
  %endif%
  %ifreason gatekeepers%
    protože nejste správcem konference.
  %endif%
%endif%

