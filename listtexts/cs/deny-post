--=_$random0$$random1$_=
Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: 8bit

%text prologue%

%wrap%Zprávu od <$posteraddr$> s předmětem "$subject$" se nepodařilo doručit,
protože
%ifreason maxmailsize%
  je příliš velká. Maximální velikost zprávy je $maxmailsize$ bajtů.
%endif%
%ifreason tocc%
  adresa konference nebyla nalezena v poli přijemce (To:) nebo kopie (Cc:).
%endif%
%ifreason access%
  její zaslání bylo zamezeno přístupovými právy stanovenými správcem konference.
%endif%
%ifreason expired%
  vypršela lhůta pro uvolnění zprávy moderátorem konference.
%endif%
%ifreason reject%
  byla zamítnuta moderátorem konference.
%endif%
%ifreason subonlypost%
  nejste členem konference.

  %ifncontrol closedlist%%ifncontrol closedlistsub%%ifncontrol moderators%
    %^%%text subrelease%
  %endif%%endif%%endif%

  %ifcontrol closedlist closedlistsub%
    %^%%wrap%Pokud si přejete být členem, musíte kontaktovat vlastníka konference.
    Můžete ho kontaktovat na adrese <$list+$owner@$domain$>.
  %endif%

  %^%%wrap%Pokud si myslíte, že členem jste, možná jste přihlášení s jinou
  emailovou adresou. Můžete ji zjistit z uvítacího emailu, který jste
  obdrželi po přihlášení do konference. Hledejte pole "Return-Path" v
  hlavičce uvítacího emailu.
%endif%
%ifreason modonlypost%
  nejste moderátor konference.
%endif%

%ifreason maxmailsize%
  %^%(Začátek zprávy je uveden níže.)
%else%
  %^%(Zpráva je uvedena níže.)
%endif%

